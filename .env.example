# ---------------------------------------------------------------------------
# Copy this file to .env in the ROOT, and also to frontend/.env.local and
# admin/.env.local (Next.js only reads env files from its own app directory).
# ---------------------------------------------------------------------------

# AWS S3 (paper PDFs/DOCX storage, and the JSON "database" - see README)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="ijaac-submissions"
# Optional: CloudFront or custom domain in front of the bucket for public assets (book covers etc.)
AWS_S3_PUBLIC_BASE_URL=""

# Nodemailer (Gmail App Password - see README "Email setup" section)
GMAIL_USER="ijaac.official@gmail.com"
GMAIL_APP_PASSWORD=""
MAIL_FROM_NAME="IJAAC Editorial Office"
EDITOR_NOTIFICATION_EMAIL="ijaac.official@gmail.com"

# Admin app auth (NextAuth / Auth.js). NEXTAUTH_SECRET also keys the emailed
# login codes, so rotating it invalidates any code that's in flight.
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Used once by `pnpm db:seed` to create the first admin user. Admins sign in
# with a one-time code emailed to this address - there is no password.
ADMIN_SEED_EMAIL="ijaac.official@gmail.com"

# Public site URL (used in email links back to the admin dashboard / frontend)
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# Razorpay (submission checkout fee)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
SUBMISSION_FEE_INR="500"
